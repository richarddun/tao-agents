{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System Sentinel posture report",
  "description": "Result contract for the system-assessment taskrail. A read-only assessment of a workstation's security posture.",
  "type": "object",
  "required": ["generated", "agent", "os", "areas", "findings", "recommendations"],
  "additionalProperties": false,
  "properties": {
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of the assessment."
    },
    "agent": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "system-sentinel" },
        "version": { "type": "string" }
      }
    },
    "os": {
      "type": "object",
      "required": ["family", "version"],
      "properties": {
        "family": { "type": "string", "enum": ["linux", "macos", "unknown"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "kernel": { "type": "string" }
      }
    },
    "areas": {
      "type": "array",
      "description": "One entry per assessed area, each with its own risk rating.",
      "items": {
        "type": "object",
        "required": ["name", "rating", "summary"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["storage", "memory_and_load", "exposure", "patching", "accounts", "system"]
          },
          "rating": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INFO"] },
          "summary": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "severity", "evidence_field", "observation"],
        "properties": {
          "area": { "type": "string" },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INFO"] },
          "evidence_field": {
            "type": "string",
            "description": "The inventory field this finding is derived from."
          },
          "observation": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "action", "owner"],
        "properties": {
          "finding": { "type": "string" },
          "action": { "type": "string" },
          "owner": { "type": "string", "description": "Who performs the action; always the operator." }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "description": "Fields the inventory could not determine, with reasons.",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
